# OpenAI (used for research summarization, post writing, and image generation)
OPENAI_API_KEY=

# SerpApi (Google Search API) - used for the research step
SERPAPI_API_KEY=

# LinkedIn (see README.md "LinkedIn setup" section for how to get this)
LINKEDIN_ACCESS_TOKEN=

# Jooble (used by job_main.py to search job listings) - free key at jooble.org/api/about
JOOBLE_API_KEY=

# --- Optional (see README.md for details) ---
# LINKEDIN_PERSON_URN=
# LINKEDIN_ORG_URN=
# DRY_RUN=false
# CRON_SECRET=      # required in production to protect /api/cron/* endpoints
# GITHUB_TOKEN=      # PAT with contents:write on your repo, for the newsletter draft store
# GITHUB_REPO=Gautam5815/agents
# GITHUB_BRANCH=main
# HUNTER_API_KEY=      # optional, for named contact lookup in job_main.py
# IMAP_EMAIL=          # your Gmail/Outlook address, for reading job-alert emails
# IMAP_APP_PASSWORD=   # an app password (not your normal password), see README.md
# IMAP_HOST=imap.gmail.com
